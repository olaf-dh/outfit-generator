{% extends 'base.html.twig' %}

{% set message = 'dashboard' %}

{% block title %}{{ (message ~ '.title')|trans }}{% endblock %}

{% block body %}
    {% for label, messages in app.flashes %}
        <div class="alert alert-{{ label }}">
            {% for message in messages %}
                <p>{{ message }}</p>
            {% endfor %}
        </div>
    {% endfor %}
    <div class="container py-5">
        <h1 class="mb-4">👋 {{ (message ~ '.welcome')|trans({'{{ user }}': app.user.firstName}) }}</h1>

        <div class="row g-4">
            {% include 'dashboard/_card.html.twig' with {
                icon: '🧺',
                title: (message ~ '.card.clothing.title')|trans,
                text: (message ~ '.card.clothing.text')|trans({'{{ count }}': clothingItems|length}),
                route: 'app_clothing_item_index',
                button: (message ~ '.card.clothing.button')|trans,
                buttonClass: 'btn-outline-primary'
            } %}

            {% include 'dashboard/_card.html.twig' with {
                icon: '🎯',
                title: (message ~ '.card.outfit.title')|trans,
                text: (message ~ '.card.outfit.text')|trans,
                route: 'app_outfit_generator',
                button: (message ~ '.card.outfit.button')|trans,
                buttonClass: 'btn-success'
            } %}

            {% include 'dashboard/_card.html.twig' with {
                icon: '📸',
                title: (message ~ '.card.batch_upload.title')|trans,
                text: (message ~ '.card.batch_upload.text')|trans,
                route: 'app_clothing_item_batch_upload',
                button: (message ~ '.card.batch_upload.button')|trans,
                buttonClass: 'btn-outline-primary'
            } %}

            {% if is_granted('ROLE_ADMIN') %}
                {% include 'dashboard/_card.html.twig' with {
                    icon: '🧑‍🎨',
                    title: 'Eigenschaften verwalten',
                    text: 'Bearbeite alle Eigenschaften wie Farbe, Stil, usw.',
                    route: 'app_property_index',
                    button: 'Bearbeiten',
                    buttonClass: 'btn-outline-secondary'
                } %}
            {% endif %}
        </div>

        <hr class="my-5">

        <h4>🕘 {{ (message ~ '.last_items')|trans }}</h4>
        <ul class="list-group list-group-flush">
            {% for item in recentItems %}
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    {{ item.name }}
                    {% if item.subCategory is not null %}
                        ({{ ('category.name.' ~ item.subCategory.category)|trans }})
                    {% endif %}
                </li>
            {% else %}
                <li class="list-group-item">{{ (message ~ '.no_items')|trans }}.</li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
