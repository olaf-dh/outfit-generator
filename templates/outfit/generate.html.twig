{% extends 'base.html.twig' %}

{% set t = 'outfit.generator' %}

{% block title %}{{ (t ~ '.title')|trans }}{% endblock %}

{% block body %}
    <div class="container py-4">

        {# Flash Messages #}
        {% for label, messages in app.flashes %}
            {% for msg in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show" role="alert">
                    {{ msg|trans }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <h1 class="h3 mb-4">{{ (t ~ '.title')|trans }}</h1>

        <div class="row g-4">

            {# Left column: Form #}
            <div class="col-lg-5">
                <div class="card shadow-sm border-0 rounded-4">
                    <div class="card-body p-4">
                        {{ form_start(form) }}

                        {# Seed-Items Grid #}
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                {{ (t ~ '.form.label.seed_items')|trans }}
                                <small class="text-muted fw-normal">(1–2)</small>
                            </label>

                            {# Verstecktes Formularfeld – wird per JS befüllt #}
                            <div style="display:none">
                                {% for choice in form.seedItems %}
                                    {{ form_widget(choice, {attr: {class: 'seed-item-checkbox'}}) }}
                                {% endfor %}
                            </div>

                            {# Tab Navigation #}
                            <ul class="nav nav-tabs nav-sm" id="seedItemTabs" role="tablist">
                                {% for categoryName, group in grouped %}
                                    <li class="nav-item" role="presentation">
                                        <button class="nav-link py-1 px-2 {% if loop.first %}active{% endif %}"
                                                style="font-size: 0.8rem;"
                                                data-bs-toggle="tab"
                                                data-bs-target="#seed-tab-{{ loop.index }}"
                                                type="button">
                                            {{ ('category.name.' ~ categoryName)|trans }}
                                        </button>
                                    </li>
                                {% endfor %}
                            </ul>

                            {# Tab Content #}
                            <div class="tab-content border border-top-0 rounded-bottom p-2" id="seedItemTabsContent">
                                {% for categoryName, group in grouped %}
                                    <div class="tab-pane fade {% if loop.first %}show active{% endif %}"
                                         id="seed-tab-{{ loop.index }}">

                                        <div class="row row-cols-3 row-cols-sm-4 g-2 mt-1">
                                            {% for item in group %}
                                                <div class="col">
                                                    <div class="seed-item-card border rounded-3 overflow-hidden
                                        d-flex flex-column align-items-center p-1 text-center"
                                                         data-id="{{ item.id }}"
                                                         style="cursor: pointer; transition: all 0.15s;">

                                                        {# Foto #}
                                                        {% if item.photoPath %}
                                                            <img src="{{ asset('uploads/clothing/' ~ item.photoPath) }}"
                                                                 class="w-100 rounded-2 object-fit-cover"
                                                                 style="height: 80px;"
                                                                 alt="{{ item.name }}">
                                                        {% else %}
                                                            <div class="w-100 bg-light rounded-2 d-flex align-items-center
                                                justify-content-center"
                                                                 style="height: 80px;">
                                                                <span style="font-size: 1.5rem;">👕</span>
                                                            </div>
                                                        {% endif %}

                                                        {# Name #}
                                                        <small class="mt-1 text-truncate w-100"
                                                               style="font-size: 0.65rem;"
                                                               title="{{ item.name }}">
                                                            {{ item.name }}
                                                        </small>
                                                    </div>
                                                </div>
                                            {% endfor %}
                                        </div>

                                    </div>
                                {% endfor %}
                            </div>

                            {{ form_errors(form.seedItems) }}
                        </div>

                        {# Style #}
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                {{ (t ~ '.form.label.style')|trans }}
                            </label>
                            {{ form_widget(form.style) }}
                            {{ form_errors(form.style) }}
                        </div>

                        {# Season #}
                        <div class="mb-3">
                            <label class="form-label fw-bold">
                                {{ (t ~ '.form.label.season')|trans }}
                            </label>
                            {{ form_widget(form.season) }}
                            {{ form_errors(form.season) }}
                        </div>

                        {# Weather optional #}
                        <div class="mb-4">
                            <label class="form-label fw-bold">
                                {{ (t ~ '.form.label.weather')|trans }}
                                <small class="text-muted fw-normal">{{ 'form.optional'|trans }}</small>
                            </label>
                            {{ form_widget(form.weather) }}
                            {{ form_errors(form.weather) }}
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            {{ (t ~ '.form.button.generate')|trans }}
                        </button>

                        {{ form_end(form) }}
                    </div>
                </div>
            </div>

            {# Right column: suggestions #}
            <div class="col-lg-7">

                {% if suggestions is not empty %}
                    <h2 class="h5 mb-3">{{ (t ~ '.suggestions.title')|trans }}</h2>

                    {% for suggestion in suggestions %}
                        <div class="card shadow-sm border-0 rounded-4 mb-3">
                            <div class="card-header bg-transparent border-0 pt-3 px-4 pb-0">
                                <div class="d-flex justify-content-between align-items-center">
                                    <h6 class="mb-0">
                                        {{ (t ~ '.suggestions.outfit')|trans({'%number%': loop.index}) }}
                                    </h6>
                                    <span class="badge bg-success bg-opacity-10 text-success">
                                    {{ (t ~ '.suggestions.score')|trans({'%score%': suggestion.score}) }}
                                </span>
                                </div>
                            </div>
                            <div class="card-body px-4 pb-4 pt-2">

                                {# Items in one row #}
                                <div class="row row-cols-2 row-cols-sm-3 row-cols-md-4 row-cols-xl-6 g-2">
                                    {% for item in suggestion.items %}
                                        <div class="col">
                                            <div class="text-center">

                                                {# Photo #}
                                                {% if item.photoPath %}
                                                    <img src="{{ asset('uploads/clothing/' ~ item.photoPath) }}"
                                                         class="w-100 rounded-3 object-fit-cover shadow-sm"
                                                         style="height: 100px;"
                                                         alt="{{ item.name }}">
                                                {% else %}
                                                    <div class="w-100 bg-light rounded-3 d-flex align-items-center
                                                            justify-content-center shadow-sm"
                                                         style="height: 100px;">
                                                        <span style="font-size: 2rem;">👕</span>
                                                    </div>
                                                {% endif %}

                                                {# Name #}
                                                <small class="d-block mt-1 text-truncate"
                                                       style="font-size: 0.7rem;"
                                                       title="{{ item.name }}">
                                                    {{ item.name }}
                                                </small>

                                                {# Category #}
                                                <small class="text-muted d-block"
                                                       style="font-size: 0.65rem;">
                                                    {{ ('category.name.' ~ item.subCategory.category.name)|trans }}
                                                </small>

                                                {# Primary colors #}
                                                {% set primary = item.itemColors|filter(ic => ic.isPrimary())|first %}
                                                {% if primary is defined %}
                                                    <span style="
                                                        display: inline-block;
                                                        width: 25px;
                                                        height: 15px;
                                                        background-color: {{ primary.color.hexCode }};
                                                        border: 1px solid #aaa;
                                                        border-radius: 2px;
                                                        margin-top: 3px;
                                                        " title="{{ primary.color.name }}"></span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>

                            </div>
                        </div>
                    {% endfor %}

                {% elseif app.request.isMethod('POST') %}
                    {# Form was send but no suggestions #}
                    <div class="d-flex align-items-center justify-content-center h-100">
                        <div class="text-center text-muted py-5">
                            <div style="font-size: 3rem;">🤷</div>
                            <p class="mt-3">{{ (t ~ '.no_suggestions')|trans }}</p>
                        </div>
                    </div>

                {% else %}
                    {# Not now submit #}
                    <div class="d-flex align-items-center justify-content-center h-100">
                        <div class="text-center text-muted py-5">
                            <div style="font-size: 3rem;">👔</div>
                            <p class="mt-3">{{ (t ~ '.hints.select_items')|trans }}</p>
                        </div>
                    </div>
                {% endif %}

            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const cards    = document.querySelectorAll('.seed-item-card');
            const maxSelect = 2;

            function getSelected() {
                return document.querySelectorAll('.seed-item-card.selected');
            }

            cards.forEach(card => {
                card.addEventListener('click', () => {
                    const id       = card.dataset.id;
                    const checkbox = document.querySelector(`.seed-item-checkbox[value="${id}"]`);

                    if (!checkbox) return;

                    if (card.classList.contains('selected')) {
                        // Deselect
                        card.classList.remove('selected');
                        card.style.borderColor     = '';
                        card.style.borderWidth     = '';
                        card.style.backgroundColor = '';
                        checkbox.checked = false;
                    } else {
                        // Select – max 2
                        if (getSelected().length >= maxSelect) return;

                        card.classList.add('selected');
                        card.style.borderColor     = '#0d6efd';
                        card.style.borderWidth     = '2px';
                        card.style.backgroundColor = '#f0f7ff';
                        checkbox.checked = true;
                    }

                    // Not selected items gray out when max is reached
                    const selectedCount = getSelected().length;
                    cards.forEach(c => {
                        if (!c.classList.contains('selected')) {
                            c.style.opacity = selectedCount >= maxSelect ? '0.4' : '';
                            c.style.pointerEvents = selectedCount >= maxSelect ? 'none' : '';
                        }
                    });
                });
            });
        });
    </script>
{% endblock %}
