{% extends 'base.html.twig' %}

{% block title %}{{ title|trans }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="card shadow">
            <div class="card-header">
                <h1>{{ title|trans }}</h1>
            </div>
            <div class="card-body">
                {{ form_start(form) }}
                {{ form_end(form) }}
                <a href="{{ path(indexRoute, {'entityType': entityType}) }}" class="btn btn-link mt-3">
                    {{ 'property.entity_show.index_route'|trans }}
                </a>
            </div>
        </div>
    </div>
{% endblock %}
