{% extends 'base.html.twig' %}

{% block title %}{{ title|trans }}{% endblock %}

{% block body %}
    <div class="container mt-5">
        <div class="card shadow border-0 rounded-4">
            <div class="card-header">
                <h1>{{ title|trans }}</h1>
            </div>

            {% if from == 'batch_review' and totalUnreviewed > 0 %}
                <div class="px-4 pt-3">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <small class="text-muted">
                            {{ 'batch_upload.review.progress'|trans({
                                '%current%': currentPosition,
                                '%total%': totalUnreviewed
                            }) }}
                        </small>
                        <small class="text-muted">
                            {{ ((currentPosition / totalUnreviewed) * 100)|round }}%
                        </small>
                    </div>
                    <div class="progress" style="height: 6px;">
                        <div class="progress-bar bg-success"
                             role="progressbar"
                             style="width: {{ ((currentPosition / totalUnreviewed) * 100)|round }}%">
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="card-body p-4">
                {{ form_start(form, {'method': 'POST', 'attr': {'enctype': 'multipart/form-data'}}) }}
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-bold">
                            {{ 'clothing_item.form.label.name'|trans }}
                        </label>
                        <div class="border rounded-3 p-2 bg-light">
                            {{ form_widget(form.name) }}
                        </div>
                        {{ form_errors(form.name) }}
                    </div>

                    <div class="col-md-6">
                        <label class="form-label fw-bold">
                            {{ 'clothing_item.form.label.subcategory'|trans }}
                        </label>
                        <div class="border rounded-3 p-2 bg-light">
                            {{ form_widget(form.subCategory) }}
                        </div>
                        {{ form_errors(form.subCategory) }}
                    </div>
                </div>

                <div class="row g-3 mt-1">

                    <div class="col-md-3">
                        <label class="form-label fw-bold">
                            {{ 'clothing_item.form.label.min_layer_depth'|trans }}
                        </label>
                        <div class="border rounded-3 p-3 bg-light">
                            {{ form_widget(form.minLayerDepth) }}
                        </div>
                        {{ form_errors(form.minLayerDepth) }}
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">
                            {{ 'clothing_item.form.label.max_layer_depth'|trans }}
                        </label>
                        <div class="border rounded-3 p-3 bg-light">
                            {{ form_widget(form.maxLayerDepth) }}
                        </div>
                        {{ form_errors(form.maxLayerDepth) }}
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-bold">
                            {{ 'clothing_item.form.label.notes'|trans }}
                        </label>
                        <div class="border rounded-3 p-1 bg-light">
                            {{ form_widget(form.notes) }}
                        </div>
                        {{ form_errors(form.notes) }}
                    </div>
                </div>

                {% if isEdit == true %}
                    <div class="mt-4">
                        <label class="form-label fw-bold">
                            {{ 'clothing_item.form.label.styles'|trans }}
                        </label>
                        <div class="border rounded-3 p-3 bg-light">
                            {{ form_widget(form.styles) }}
                        </div>
                        {{ form_errors(form.styles) }}
                    </div>

                    <div class="mt-4">
                        <label class="form-label fw-bold">
                            {{ 'clothing_item.form.label.patterns'|trans }}
                        </label>
                        <div class="border rounded-3 p-3 bg-light">
                            {{ form_widget(form.pattern) }}
                        </div>
                        {{ form_errors(form.pattern) }}
                    </div>

                    <div class="row g-3 mt-1">
                        <div class="col-md-5">
                            <label class="form-label fw-bold">
                                {{ 'clothing_item.form.label.seasons'|trans }}
                            </label>
                            <div class="border rounded-3 p-3 bg-light">
                                {{ form_widget(form.seasons) }}
                            </div>
                            {{ form_errors(form.seasons) }}
                        </div>

                        <div class="col-md-7">
                            <label class="form-label fw-bold">
                                {{ 'clothing_item.form.label.weather_conditions'|trans }}
                            </label>
                            <div class="border rounded-3 p-3 bg-light">
                                {{ form_widget(form.weatherConditions) }}
                            </div>
                            {{ form_errors(form.weatherConditions) }}
                        </div>
                    </div>
                {% endif %}

                <div class="row g-3 mt-1">
                    <div class="col-md-2">
                        {# Preview of current display photo #}
                        {% if isEdit and form.vars.data.displayPhotoPath is not null %}
                            <label class="form-label fw-bold">
                                {{ 'clothing_item.form.label.current_display_photo'|trans }}
                            </label>
                            <div class="mb-2">
                                <img src="{{ asset('uploads/clothing/' ~ form.vars.data.displayPhotoPath) }}"
                                     class="img-thumbnail"
                                     style="max-height: 150px; object-fit: contain;"
                                     alt="{{ form.vars.data.name }}">
                            </div>
                        {% elseif form.vars.data.displayPhotoPath is null %}
                            <label class="form-label fw-bold">
                                {{ 'clothing_item.form.label.photo_upload'|trans }}
                            </label>
                        {% endif %}
                        <div class="border rounded-3 p-2 bg-light">
                            {{ form_widget(form.displayPhoto) }}
                        </div>
                        {{ form_errors(form.displayPhoto) }}
                        <small class="text-muted d-block mt-1">
                            {{ 'clothing_item.form.hint.display_photo'|trans }}
                        </small>
                    </div>

                    <div class="col-md-2">
                        {% if isEdit and form.vars.data.photoPath is not null %}
                            <label class="form-label fw-bold">
                                {{ 'clothing_item.form.label.analysis_photo_preview'|trans }}
                            </label>
                            <div class="mb-2">
                                <img src="{{ path('app_clothing_item_analysis_photo', {id: form.vars.data.id}) }}"
                                     class="img-thumbnail"
                                     style="max-height: 150px; object-fit: contain;"
                                     alt="{{ form.vars.data.name }}">
                            </div>
                        {% elseif form.vars.data.photoPath is null %}
                            <label class="form-label fw-bold">
                                {{ 'clothing_item.form.label.photo_upload'|trans }}
                            </label>
                        {% endif %}
                        <div class="border rounded-3 p-2 bg-light">
                            {{ form_widget(form.photo) }}
                        </div>
                        {{ form_errors(form.photo) }}
                        <small class="text-muted d-block mt-1">
                            {{ 'clothing_item.form.hint.analysis_photo'|trans }}
                        </small>
                    </div>

                    {% if isEdit %}
                        <div class="col-md-2">
                            <div class="flex-grow-1">
                                <label class="form-label fw-bold">
                                    {{ 'clothing_item.form.label.primary_color'|trans }}
                                </label>
                                {% for child in form.primaryColor %}
                                    {% set hex = child.vars.attr['data-hex'] %}

                                    <label class="d-flex align-items-center gap-2 mb-2">
                                        {{ form_widget(child) }}
                                        <span
                                            style="
                                                display:inline-block;
                                                width:2.5rem;
                                                height:1rem;
                                                background-color: {{ hex }};
                                                border:1px solid #aaa;
                                                border-radius:3px;
                                                "></span>
                                        {{ child.vars.label }}
                                    </label>
                                {% endfor %}
                            </div>
                        </div>

                        <div class="col-md-2">
                            <div class="flex-grow-1">
                                <label class="form-label fw-bold">
                                    {{ 'clothing_item.form.label.secondary_colors'|trans }}
                                </label>
                                {% for child in form.secondaryColors %}
                                    {% set hex = child.vars.attr['data-hex'] %}

                                    <label class="d-flex align-items-center gap-2 mb-2">
                                        {{ form_widget(child) }}
                                        <span
                                            style="
                                                display:inline-block;
                                                width:2.5rem;
                                                height:1rem;
                                                background-color: {{ hex }};
                                                border:1px solid #aaa;
                                                border-radius:3px;
                                                "></span>
                                        {{ child.vars.label }}
                                    </label>
                                {% endfor %}
                            </div>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label fw-bold">
                                {{ 'clothing_item.form.label.materials'|trans }}
                            </label>

                            <div id="item_materials_wrapper"
                                 data-prototype="{{ form_widget(form.itemMaterials.vars.prototype)|e('html_attr') }}"
                                 data-index="{{ form.itemMaterials|length }}">

                                {% for materialForm in form.itemMaterials %}
                                    <div class="material-entry row g-2 align-items-center mb-2">
                                        <div class="col-md-6">
                                            {{ form_widget(materialForm.material) }}
                                            {{ form_errors(materialForm.material) }}
                                        </div>
                                        <div class="col-md-4">
                                            <div class="input-group">
                                                {{ form_widget(materialForm.percentage) }}
                                                <span class="input-group-text">%</span>
                                            </div>
                                            {{ form_errors(materialForm.percentage) }}
                                        </div>
                                        <div class="col-md-2">
                                            <button type="button" class="btn btn-danger btn-sm remove-material w-100">
                                                {{ 'clothing_item.form.button.remove_material'|trans }}
                                            </button>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>

                            <div class="d-flex align-items-center gap-3 mt-2">
                                <button type="button" id="add_material_button" class="btn btn-outline-secondary btn-sm">
                                    + {{ 'clothing_item.form.button.add_material'|trans }}
                                </button>
                                <span class="text-muted small">
                                    &nbsp;&nbsp;{{ 'clothing_item.form.materials.total'|trans }}:
                                    <strong id="total_percentage">0</strong>%
                                    <br>
                                    <span id="percentage_warning" class="text-danger ms-2 d-none">
                                        {{ 'clothing_item.form.materials.not_100'|trans }}
                                    </span>
                                    <span id="percentage_ok" class="text-success ms-2 d-none">✓</span>
                                </span>
                            </div>
                        </div>
                    {% endif %}
                </div>

                <div class="mt-4 d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        {{ (isEdit ? 'clothing_item.edit.button' : 'clothing_item.add.button')|trans }}
                    </button>
                    <a href="{{ path(list_path) }}" class="btn btn-outline-secondary">
                        {{ 'clothing_item.form.button.cancel'|trans }}
                    </a>
                </div>
                {{ form_end(form) }}
                <a href="{{ path(list_path) }}" class="btn btn-link mt-3">
                    {{ 'clothing_item.form.back_to_dashboard'|trans }}
                </a>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const wrapper    = document.getElementById('item_materials_wrapper');
            const addBtn     = document.getElementById('add_material_button');
            const totalEl    = document.getElementById('total_percentage');
            const warningEl  = document.getElementById('percentage_warning');
            const okEl       = document.getElementById('percentage_ok');

            // --- Percent-Calculations ---

            function updateTotal() {
                const inputs = wrapper.querySelectorAll('.percentage-input');
                let total    = 0;

                inputs.forEach(input => {
                    const val = parseFloat(input.value);
                    if (!isNaN(val)) {
                        total += val;
                    }
                });

                total = Math.round(total * 10) / 10;
                totalEl.textContent = total;

                if (total === 100) {
                    warningEl.classList.add('d-none');
                    okEl.classList.remove('d-none');
                    addBtn.disabled = true;
                    addBtn.title    = '';
                } else {
                    warningEl.classList.remove('d-none');
                    okEl.classList.add('d-none');
                    addBtn.disabled = false;
                }
            }

            // --- Remove row ---

            function addRemoveButton(entryDiv) {
                const btn = entryDiv.querySelector('.remove-material');
                if (btn) {
                    btn.addEventListener('click', () => {
                        entryDiv.remove();
                        updateRemoveVisibility();
                        updateTotal();
                    });
                }
            }

            function updateRemoveVisibility() {
                const entries   = wrapper.querySelectorAll('.material-entry');
                const showRemove = entries.length > 1;
                entries.forEach(entry => {
                    const btn = entry.querySelector('.remove-material');
                    if (btn) {
                        btn.style.display = showRemove ? 'inline-block' : 'none';
                    }
                });
            }

            // --- Add new row ---

            function addMaterialEntry() {
                const prototype = wrapper.dataset.prototype;
                const index     = parseInt(wrapper.dataset.index);
                const html      = prototype.replace(/__name__/g, index);

                wrapper.dataset.index = index + 1;

                const div = document.createElement('div');
                div.classList.add('material-entry', 'row', 'g-2', 'align-items-center', 'mb-2');
                div.innerHTML = html;

                // Percent-Input Listener
                const percentInput = div.querySelector('.percentage-input');
                if (percentInput) {
                    percentInput.addEventListener('input', updateTotal);
                }

                addRemoveButton(div);
                wrapper.appendChild(div);
                updateRemoveVisibility();
                updateTotal();
            }

            // --- Initial ---

            // Initialize existing rows
            wrapper.querySelectorAll('.material-entry').forEach(entry => {
                addRemoveButton(entry);

                const percentInput = entry.querySelector('.percentage-input');
                if (percentInput) {
                    percentInput.addEventListener('input', updateTotal);
                }
            });

            // First entry: Hide remove button
            updateRemoveVisibility();

            // Calculate initial total percentage
            updateTotal();

            // Add-Button
            addBtn.addEventListener('click', addMaterialEntry);

            // When no entries exist, automatically add a row
            if (wrapper.querySelectorAll('.material-entry').length === 0) {
                addMaterialEntry();
            }

            // --- Form-Submit: Warning if not 100% ---
            const form = wrapper.closest('form');
            if (form) {
                form.addEventListener('submit', (e) => {
                    const inputs = wrapper.querySelectorAll('.percentage-input');
                    if (inputs.length === 0) return; // no Materials = OK

                    let total = 0;
                    inputs.forEach(input => {
                        const val = parseFloat(input.value);
                        if (!isNaN(val)) total += val;
                    });

                    total = Math.round(total * 10) / 10;

                    if (total !== 100) {
                        e.preventDefault();
                        warningEl.classList.remove('d-none');
                        wrapper.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }
                });
            }
        });
    </script>
{% endblock %}
