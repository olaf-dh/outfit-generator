{% extends 'base.html.twig' %}

{% set message = 'security' %}

{% block title %}{{ (message ~ '.title')|trans }}!{% endblock %}

{% block body %}
<form method="post">
    {% if error %}
        <div class="alert alert-danger">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
    {% endif %}

    {% if app.user %}
        <div class="mb-3">
            {{ (message ~ '.message.logged_in')|trans }} {{ app.user.userIdentifier }},
            <a href="{{ logout_path() }}">{{ 'templates.base.logout'|trans }}</a>
        </div>
    {% endif %}

    <h1 class="h3 mb-3 font-weight-normal">{{ (message ~ '.please')|trans }}</h1>
    <label for="inputEmail">{{ (message ~ '.email')|trans }}</label>
    <input type="email" value="{{ last_username }}" name="email" id="inputEmail"
           class="form-control" autocomplete="email" required autofocus>
    <label for="inputPassword">{{ (message ~ '.password')|trans }}</label>
    <input type="password" name="password" id="inputPassword" class="form-control"
           autocomplete="current-password" required>
    <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">

    <div class="checkbox mb-3">
        <label>
            <input type="checkbox" name="_remember_me"> {{ (message ~ '.remember_me')|trans }}
        </label>
    </div>

    <button class="btn btn-lg btn-primary" type="submit">
        {{ (message ~ '.submit')|trans }}
    </button>
</form>
{% endblock %}
